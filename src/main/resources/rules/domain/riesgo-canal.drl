package com.antifraude.drools;

import com.antifraude.drools.RiskContext;

global com.antifraude.drools.DroolsService.ScoreTracker scoreTracker;

// Canal de alto riesgo — configurable vía canal_transaccion.alto_riesgo (V32).
// Ya no se usan literales hardcodeados; el builder resuelve el flag en el contexto.
rule "Canal de alto riesgo"
    when
        $ctx : RiskContext(canalAltoRiesgo == true)
    then
        scoreTracker.addScore(15);
        System.out.println("[Drools] Canal de alto riesgo detectado");
end
