package com.antifraude.drools;

import com.antifraude.drools.RiskContext;
import com.antifraude.drools.fact.ListaFact;

global com.antifraude.drools.DroolsService.ScoreTracker scoreTracker;

rule "Lista negra detectada"
    when
        $ctx : RiskContext()
        $l : ListaFact(tipoLista == "NEGRA") from $ctx.getListasNegras()
    then
        double conf = $l.getScoreConfianza() != null ? $l.getScoreConfianza().doubleValue() : 100.0;
        scoreTracker.addScore(100.0 * conf / 100.0);
        System.out.println("[Drools] LISTA NEGRA detectada: " + $l.getNombreCompleto() + " - Lista: " + $l.getNombreLista() + " - Confianza: " + conf);
end

rule "Lista gris detectada"
    when
        $ctx : RiskContext()
        $l : ListaFact(tipoLista == "GRIS") from $ctx.getListasGrises()
    then
        double conf = $l.getScoreConfianza() != null ? $l.getScoreConfianza().doubleValue() : 100.0;
        scoreTracker.addScore(50.0 * conf / 100.0);
        System.out.println("[Drools] LISTA GRIS detectada: " + $l.getNombreCompleto() + " - Lista: " + $l.getNombreLista() + " - Confianza: " + conf);
end

rule "Lista blanca detectada"
    when
        $ctx : RiskContext()
        $l : ListaFact(tipoLista == "BLANCA") from $ctx.getListasBlancas()
    then
        double conf = $l.getScoreConfianza() != null ? $l.getScoreConfianza().doubleValue() : 100.0;
        scoreTracker.addScore(-30.0 * conf / 100.0);
        System.out.println("[Drools] LISTA BLANCA detectada: " + $l.getNombreCompleto() + " - Lista: " + $l.getNombreLista() + " - Confianza: " + conf);
end
