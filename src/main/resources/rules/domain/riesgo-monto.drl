package com.antifraude.drools;

import com.antifraude.drools.RiskContext;
import com.antifraude.drools.fact.ControlImporteFact;
import com.antifraude.drools.fact.TransaccionFact;

global com.antifraude.drools.DroolsService.ScoreTracker scoreTracker;

rule "Monto supera control multimoneda"
    when
        $ctx : RiskContext()
        $t : TransaccionFact(monto != null, monedaCodigo != null) from $ctx.getTransaccionFact()
        $c : ControlImporteFact(
            monedaCodigo != null,
            montoMaximo != null,
            monedaCodigo.equalsIgnoreCase($t.getMonedaCodigo()),
            eval($t.getMonto().compareTo(getMontoMaximo()) > 0)
        ) from $ctx.getControlesImporte()
    then
        String severidad = $c.getSeveridad() != null ? $c.getSeveridad().toUpperCase() : "MEDIA";
        double score = "CRITICA".equals(severidad) ? 70 : ("ALTA".equals(severidad) ? 50 : 30);
        scoreTracker.addScore(score);
        System.out.println("[Drools] Monto supera control multimoneda: "
                + $t.getMonto() + " " + $t.getMonedaCodigo()
                + " > " + $c.getMontoMaximo() + " " + $c.getMonedaCodigo());
end
