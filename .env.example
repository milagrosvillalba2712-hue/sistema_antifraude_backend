# Solo desarrollo local. Producción debe inyectar estos valores desde un secret store.
# Topología simulada de dos servidores: la base del BANCO vive en su propia
# instancia PostgreSQL (regula-db-banco, :5434, aislada del CP de Regula).
DB_HOST=localhost
DB_PORT=5434
DB_NAME=antifraude_demo
SPRING_PROFILES_ACTIVE=demo
DB_USER=regula_app_login
DB_PASSWORD=replace_with_app_password
FLYWAY_DB_USER=regula_owner
FLYWAY_DB_PASSWORD=replace_with_owner_password
JWT_SECRET=replace_with_at_least_32_random_bytes
AES_SECRET=replace_with_32_random_bytes
HMAC_SECRET=replace_with_at_least_32_random_bytes
EXTERNAL_TRUSTSTORE=file:C:/Users/nicol/Projects/sistema_antifraude/sistema_antifraude_backend/certificates/regula-external-truststore.p12
EXTERNAL_TRUSTSTORE_PASSWORD=change_me
IDENTIFICACIONES_API_URL=https://localhost:8443
IDENTIFICACIONES_API_KEY=replace_with_random_api_key
SANCIONES_API_URL=https://localhost:8443
SANCIONES_API_KEY=replace_with_random_api_key
PEP_API_URL=https://localhost:8443
PEP_API_KEY=replace_with_random_api_key
# Screening Ofac/Listas: credencial dedicada opcional. Si no se define, cae en IDENTIFICACIONES_API_KEY.
SCREENING_API_URL=https://localhost:8443
SCREENING_API_KEY=replace_with_random_api_key
SEED_ENABLED=false
SCHEDULER_ENABLED=false
# Control Plane (servidor de Regula): hostname simulado por la tabla hosts local
LICENSES_CONTROL_PLANE_URL=http://cp-licencias.regula.local:8090
LICENSES_CONTROL_PLANE_API_KEY=replace_with_control_plane_client_key

# Mail (SMTP) - Opcional, en demo se loga a consola
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@regula.com.pa
MAIL_FROM_NAME=Regula AML

# reCAPTCHA v3 - Opcional, en demo se salta la verificacion
RECAPTCHA_SECRET_KEY=
RECAPTCHA_THRESHOLD=0.5
